# ============================================================================
# .env.example — Plantilla de variables de entorno (ESTA SÍ se sube a Git)
# ----------------------------------------------------------------------------
# 1) Copia este archivo y llámalo  .env   (ese NO se sube a Git).
# 2) Reemplaza los valores con los de tu proyecto en Supabase:
#    Dashboard → Project Settings → API.
# ============================================================================

# URL de tu proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave "publishable" (pública). La seguridad real la dan las políticas RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
